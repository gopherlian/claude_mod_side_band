// Template of a temporary test, copied to hooks/zz_dump.test.ts by regenerate.sh and deleted afterwards.
// A hooks module cannot import node:fs, so the lines the mod draws travel in the error it throws.

import { test } from 'claude-code/testing'
import { arrange, groups } from './groups/index'
import { arrangeStrip } from './groups/strip'
import { creditLines } from './sections/credit'
import type { GroupContext } from './groups/types'

/** Content columns of the docked band the screenshots show: what it asks for on a normal window. */
const COLUMNS = 28

const NOW = Date.parse('2026-11-17T17:16:20')
const endsIn = (ms: number) => new Date(NOW + ms).toISOString()

const ctx = (columns: number): GroupContext => ({
  now: NOW,
  columns,
  rows: 60,
  // The version the mod is at: regenerate.sh writes it in from .claude-plugin/plugin.json.
  update: { status: 'current', version: '__VERSION__' },
  weather: {
    status: 'ready', place: 'Valencia', temperature: 22, feelsLike: 20, humidity: 56, wind: 20,
    summary: 'Overcast', icon: '☁',
    forecast: { max: 24, min: 15, rainPercent: 3, uv: 3, sunrise: '07:47', sunset: '17:45' },
  },
  usage: {
    contextTokens: 265_000, contextWindow: 1_000_000, contextPercent: 26, costUsd: 4.82,
    startedAt: NOW - 95 * 60_000,
    limits: [
      { kind: 'five_hour', percentUsed: 41, resetsAt: endsIn(4_140_000) },
      { kind: 'seven_day', percentUsed: 23, resetsAt: endsIn(302_400_000) },
    ],
  },
  stats: {
    toolCalls: 37, activeTools: 0, lastTurnMs: 74_000, model: 'Opus 5.5', effort: 'high',
    toolTimes: [
      NOW - 9 * 60_000, NOW - 8 * 60_000 - 20_000, NOW - 8 * 60_000 - 5_000, NOW - 6 * 60_000, NOW - 5 * 60_000 - 40_000,
      NOW - 5 * 60_000 - 30_000, NOW - 5 * 60_000 - 10_000, NOW - 5 * 60_000, NOW - 3 * 60_000 - 30_000,
      NOW - 2 * 60_000 - 50_000, NOW - 2 * 60_000 - 20_000, NOW - 60_000 - 40_000, NOW - 40_000, NOW - 25_000,
    ],
    categories: [
      { name: 'System prompt', tokens: 6_000, kind: 'used' },
      { name: 'System tools', tokens: 15_000, kind: 'used' },
      { name: 'MCP tools', tokens: 37_000, kind: 'used' },
      { name: 'Memory files', tokens: 4_000, kind: 'used' },
      { name: 'Messages', tokens: 203_000, kind: 'used' },
      { name: 'Free space', tokens: 702_000, kind: 'free' },
      { name: 'Autocompact buffer', tokens: 33_000, kind: 'buffer' },
    ],
  },
  hardware: {
    cpu: { total: 34, cores: [] },
    gpus: [{ name: 'RTX 4090', util: 62, memUsedMb: 9830, memTotalMb: 24576 }],
    npus: [],
  },
  system: {
    ramPercent: 58, swapPercent: 7, diskPercent: 71, downBps: 3_400_000, upBps: 410_000, netPeakBps: 12_000_000,
    dockers: [
      { name: 'model-service', networks: ['app'], cpu: 38, gpu: true },
      { name: 'admin-ui', networks: ['app'], cpu: 12 },
      { name: 'postgres', networks: ['db'], cpu: 5 },
    ],
  },
  git: { branch: 'feat-7', changed: 3, ahead: 2, behind: 0 },
  timerEndsAt: NOW + 24 * 60_000 + 30_000,
})

test('dump', () => {
  const out: Record<string, unknown> = { columns: COLUMNS }
  const c = ctx(COLUMNS)
  for (const g of groups) out[g.id] = g.lines({ ...c, noted: true })
  out.credit = creditLines(COLUMNS)
  out.overview = arrange(c, 500, groups, creditLines(COLUMNS))
  // The strip: where the pane is not docked, 99 columns across (a half-screen terminal) and 8 rows.
  out.strip = arrangeStrip({ ...c, columns: 99 }, 8, groups)
  out.stripNarrow = arrangeStrip({ ...c, columns: 80 }, 8, groups)
  out.stripShort = arrangeStrip({ ...c, columns: 99 }, 5, groups)
  throw new Error('DUMPSTART' + JSON.stringify(out) + 'DUMPEND')
})
