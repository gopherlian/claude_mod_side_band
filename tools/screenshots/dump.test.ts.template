  columns,
  rows: 60,
  weather: {
    status: 'ready', place: 'Valencia', temperature: 22, feelsLike: 20, humidity: 56, wind: 20,
    summary: 'Overcast', icon: '☁',
    forecast: { max: 24, min: 15, rainPercent: 3, uv: 3, sunrise: '07:47', sunset: '17:45' },
  },
  usage: {
    contextTokens: 265_000, contextWindow: 1_000_000, contextPercent: 26, costUsd: 4.82,
    startedAt: NOW - 95 * 60_000,
    limits: [
      { kind: 'five_hour', percentUsed: 41, resetsAt: endsIn(4_140_000) },
      { kind: 'seven_day', percentUsed: 23, resetsAt: endsIn(302_400_000) },
    ],
  },
  stats: {
    toolCalls: 37, activeTools: 0, lastTurnMs: 74_000, model: 'Opus 5.5', effort: 'high',
    categories: [
      { name: 'Messages', tokens: 148_000 }, { name: 'System prompt', tokens: 21_000 }, { name: 'Tools', tokens: 12_000 },
