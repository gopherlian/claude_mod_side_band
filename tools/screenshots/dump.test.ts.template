test('dump', () => {
  const out: Record<string, unknown> = {}
  const c = ctx(40)
  for (const g of groups) out[g.id] = g.lines({ ...c, noted: true })
  out.footnote = groups.flatMap(g => g.footnote?.(c) ?? [])
  out.credit = creditLines(40)
  out.overview = arrange(c, 500, groups, creditLines(40))
  throw new Error('DUMPSTART' + JSON.stringify(out) + 'DUMPEND')
})
